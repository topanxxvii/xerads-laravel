{
    "name": "xerads/cms-bridge",
    "description": "Receive articles published from XerAds into a Laravel site.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "XerAds\\CmsBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XerAds\\CmsBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XerAds\\CmsBridge\\CmsBridgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
