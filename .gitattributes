# Line endings stay as committed on every platform.
* text=auto eol=lf

# What an installation does not need: Composer's dist archives leave these
# out, so a site downloads the package's code and nothing else.
/.github            export-ignore
/tests              export-ignore
/workbench          export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/pint.json          export-ignore
/testbench.yaml     export-ignore
